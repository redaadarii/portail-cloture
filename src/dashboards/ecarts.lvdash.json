      "queryLines": [
        "SELECT\n",
        "  e.mois,\n",
        "  e.entite,\n",
        "  r.nom AS nom_entite,\n",
        "  e.compte,\n",
        "  e.libelle,\n",
        "  e.budget,\n",
        "  e.reel,\n",
        "  e.ecart,\n",
        "  e.ecart_pct,\n",
        "  CASE WHEN ABS(e.ecart_pct) > 10 THEN 'Significatif' ELSE 'Normal' END AS niveau\n",
        "FROM ecarts e\n",
        "JOIN ref_entites r ON r.code = e.entite"
