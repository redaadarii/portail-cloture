# Copier en .env.local et compléter (.env.local n'est jamais commité).
# En production (Databricks Apps), ces valeurs sont fournies par le bundle (resources/portail.app.yml).

# URL du workspace, sans "/" final
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com

# Dev local : token personnel (Settings > Developer > Access tokens)
DATABRICKS_TOKEN=

# ID du SQL Warehouse : databricks warehouses list
DATABRICKS_WAREHOUSE_ID=

# Emplacement des tables
CLOTURE_CATALOG=workspace
CLOTURE_SCHEMA=cloture_dev

# Simulation de l'utilisateur connecté (dev local uniquement, ignoré en production)
DEV_USER_EMAIL=moi@exemple.com
DEV_USER_GROUPS=cloture-lecteurs
